# ---- Copy to .env and fill in. NEVER commit .env ----

# LLM provider: anthropic (default) or openai (any OpenAI-compatible chat API)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=20000

# API server
# PORT=8787
# HOST=127.0.0.1
# RATE_LIMIT_PER_MIN=12
# GLOBAL_DAILY_LIMIT=5000
# TRUST_PROXY=1          # set when behind a reverse proxy so per-IP limits work
# ALLOWED_ORIGIN=        # only if the web app is hosted on a different origin

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Where the bot reaches the shared service. Default runs the same code in-process.
# SAFEKAKI_API_URL=http://127.0.0.1:8787
# Optional: comma-separated Telegram user IDs allowed to use the bot (blank = everyone)
# TELEGRAM_ALLOWED_USER_IDS=
# BOT_RATE_LIMIT_PER_MIN=8

# Website address the bot links to (welcome message, Help and /website). Leave blank to hide the link.
# SAFEKAKI_WEBSITE_URL=http://localhost:5173
# Demo mode: 2 pretend Kakis join every room, chat, vote and leave. For demos with one phone only.
# DEMO_KAKIS=1
# DEMO_KAKIS_DELAY_MS=3500
