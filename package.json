{
  "name": "safekaki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SafeKaki — a community scam shield for Singapore seniors",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vite build",
    "preview": "vite preview --host localhost",
    "server": "node server/index.js",
    "bot": "node telegram-bot/bot.js",
    "test": "node --test \"tests/*.test.js\"",
    "eval": "node scripts/eval.js",
    "dev:all": "concurrently -k -n web,api \"npm:dev\" \"npm:server\"",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
